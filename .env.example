# Copy to .env and fill in. .env is gitignored.

# Project root. Defaults to the working directory the MCP server is launched from
# (usually your repo root). Override only if your setup is non-standard.
# All file reads are confined to this directory.
SAFEBRIDGE_PROJECT_ROOT=

# ---- Provider selection ----
# Which LLM backend to use: deepseek | openai | ollama | gemini
# Default: deepseek
SAFEBRIDGE_PROVIDER=deepseek

# API keys — set the one matching your provider.
# DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Ollama (local): no key needed. Set base URL if not on localhost.
OLLAMA_BASE_URL=http://localhost:11434

# Daily budget cap in USD. Tool calls refuse once exceeded. Resets at UTC midnight.
# Set to 0 for Ollama (local, free) or to your comfort limit for cloud providers.
SAFEBRIDGE_DAILY_BUDGET_USD=2.00

# Per-call max input tokens. Refuses if estimated payload exceeds this.
SAFEBRIDGE_MAX_INPUT_TOKENS=800000

# Path to audit log. Default: <project root>/.safebridge-audit.log (gitignored).
SAFEBRIDGE_AUDIT_LOG=

# Path to user config (allowlist, denylist, redaction patterns).
# Default: <this dir>/config.json
SAFEBRIDGE_CONFIG=

# ---- Semantic retrieval (RAG) — optional ----
# Set SAFEBRIDGE_EMBED_PROVIDER to enable safebridge_index and retrieval:true in safebridge_query.
# Embed provider: openai | ollama | gemini
SAFEBRIDGE_EMBED_PROVIDER=
# Embedding model (defaults: openai=text-embedding-3-small, ollama=nomic-embed-text, gemini=text-embedding-004)
SAFEBRIDGE_EMBED_MODEL=
# Path to vector index file (default: <project root>/.safebridge-index.json, gitignored)
SAFEBRIDGE_INDEX=
